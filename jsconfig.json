{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "scripts/**/*.mjs",
    "tools/**/*.mjs"
  ],
  "exclude": [
    "lib/client.js",
    "lib/client/**"
  ]
}
